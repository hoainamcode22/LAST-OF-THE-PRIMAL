--- !u!114 &416191155
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 416191153}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e6239eb0576efb489646d221cdd3710, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PrimalFrontier.Runtime::PrimalFrontier.Story.TutorialManager
  texts:
  - id: look
    objective: Look around
    hint: Move the mouse to look.
  - id: walk
    objective: Walk to the wreck
    hint: W A S D to move. Hold Shift to run faster.
  - id: search
    objective: Search the wreck for supplies
    hint: Walk up to a crate and press E.
  - id: wood
    objective: Collect wood
    hint: Driftwood lies along the beach. Press E next to it.
  - id: stone
    objective: Collect stones
    hint: Loose stones gather where the rocks meet the sand.
  - id: open_craft
    objective: Open the crafting menu
    hint: Press Q (or Tab, then the Crafting tab).
  - id: craft_axe
    objective: Craft a Stone Axe
    hint: Stone, wood and the ship's rope. Select it and press Craft.
  - id: fiber
    objective: Gather plant fibre
    hint: Tall fibrous plants grow behind the beach. Fibre makes cord.
  - id: water
    objective: Find fresh water
    hint: The sea will not help you. Look for a stream or a pond inland.
  - id: food
    objective: Find something to eat
    hint: Berry bushes grow along the forest edge.
  - id: campfire
    objective: Build a campfire
    hint: Craft it, choose it on the hotbar (1-8) and place it with left click.
  - id: cook
    objective: Light the fire and cook meat
    hint: Press E at the campfire with wood, then with raw meat.
  - id: spear
    objective: Craft a Stone Spear
    hint: A spear keeps danger at a distance.
  - id: explore
    objective: Explore the forest inland
    hint: Follow the stream uphill towards the meadow.
  - id: tracks
    objective: Examine the strange tracks
    hint: Something left deep prints in the mud near the meadow.
  - id: observe
    objective: Observe the grazing giant
    hint: Keep your distance. Watch, do not provoke.
  - id: return
    objective: Something is nearby. Return to camp
    hint: Head back to your fire on the beach.
  - id: shelter
    objective: Build a shelter before nightfall
    hint: Craft a Basic Shelter and place it near the fire.
  - id: night
    objective: Survive the night
    hint: Stay warm by the fire. A bedroll lets you sleep until dawn.
  observeSeconds: 4
  eveningHour: 17
  shelterRange: 6
