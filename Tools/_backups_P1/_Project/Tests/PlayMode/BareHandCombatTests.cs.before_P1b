using System.Collections;
using System.Collections.Generic;
using System.Linq;
using NUnit.Framework;
using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.TestTools;
using PrimalFrontier.AI;
using PrimalFrontier.Animation;
using PrimalFrontier.Audio;
using PrimalFrontier.Combat;
using PrimalFrontier.Combat.Weapons;
using PrimalFrontier.Core;
using PrimalFrontier.Items;
using PrimalFrontier.Player;
using PrimalFrontier.Survival;
using PrimalFrontier.UI;
using PrimalFrontier.VFX;

namespace PrimalFrontier.Tests
{
    /// <summary>a target that only records what it was hit with</summary>
    public class HitRecorder : MonoBehaviour, IDamageable
    {
        public readonly List<HitInfo> Hits = new List<HitInfo>();
        public bool IsAlive => true;
        public void TakeHit(HitInfo hit) => Hits.Add(hit);
    }

    /// <summary>
    /// Bare-hand combat (Documentation/BARE_HAND_COMBAT.md): the player starts unarmed and fights with the fists through the
    /// same WeaponController / MeleeWeapon / WeaponHitbox path as weapons: light combo 1-2-3 on repeated presses (animation
    /// events), heavy on hold or the HEAVY button, stamina spent, HitInfo.unarmed + knockback; items with a use keep it, items
    /// with no weapon role punch, a spear still fights as a spear and the hotbar switches back to the fists.
    /// </summary>
    public class BareHandCombatTests
    {
        const string PlayerPrefab = "Assets/_Project/Prefabs/Player/PFB_Player.prefab";
        GameObject _course, _player, _cam, _input;
        PlayerMotor _motor; PlayerAnimationDriver _drv; PlayerCombat _combat; InventorySystem _inv; PlayerSurvival _sv; Animator _anim; WeaponController _wc;
        CharacterAnimationEvents _events;
        readonly List<Object> _created = new List<Object>();
        readonly List<(int action, string evt)> _eventLog = new List<(int, string)>();

        [UnitySetUp]
        public IEnumerator SetUp()
        {
            yield return TestScenes.ClearIfGameplayLeft();
            PlayerInputReader.Simulate = true; ResetSim();
            _course = TestEnvironment.Build(null);
            _input = new GameObject("Input"); _input.AddComponent<PlayerInputReader>();
#if UNITY_EDITOR
            var prefab = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(PlayerPrefab);
            Assert.IsNotNull(prefab, "PFB_Player.prefab missing (run PrimalPlayerSetup)");
            _player = Object.Instantiate(prefab, new Vector3(0, 0.05f, 0), Quaternion.identity);
#endif
            _motor = _player.GetComponent<PlayerMotor>(); _drv = _player.GetComponent<PlayerAnimationDriver>(); _anim = _drv.animator;
            _combat = _player.GetComponent<PlayerCombat>(); _inv = _player.GetComponent<InventorySystem>(); _sv = _player.GetComponent<PlayerSurvival>();
            _cam = new GameObject("Cam"); _cam.tag = "MainCamera"; _cam.AddComponent<Camera>(); var tpc = _cam.AddComponent<ThirdPersonCamera>(); tpc.target = _player.transform; tpc.ignoreMask = 1 << _player.layer;
            _motor.CameraTransform = _cam.transform;
            VfxPool.Instance.ToString(); SfxPlayer.Instance.ToString();
            yield return new WaitForSeconds(0.3f);
            float t0 = Time.realtimeSinceStartup;
            while (Time.realtimeSinceStartup - t0 < 4f && !(_anim.GetCurrentAnimatorStateInfo(0).IsName("Locomotion") && !_anim.IsInTransition(0))) yield return null;
            _inv.Clear();
            _wc = _combat.Weapons;
            _events = _player.GetComponentInChildren<CharacterAnimationEvents>();
            _eventLog.Clear();
            if (_events) _events.AnimationEventRaised += OnEvent;
            yield return null;
        }

        [UnityTearDown]
        public IEnumerator TearDown()
        {
            if (_events) _events.AnimationEventRaised -= OnEvent;
            PlayerInputReader.Simulate = false; ResetSim();
            foreach (var g in new[] { _player, _cam, _input, _course }) if (g) Object.Destroy(g);
            foreach (var o in _created) if (o) Object.Destroy(o);
            _created.Clear();
            yield return null;
        }

        void OnEvent(string name, string param) { if (name.StartsWith("OnAttack")) _eventLog.Add((_wc ? _wc.CurrentAttackAction : 0, name)); }

        static void ResetSim() { var s = PlayerInputReader.Sim; s.Move = s.Look = Vector2.zero; s.Sprint = s.Walk = s.Aim = s.Jump = s.Crouch = s.Interact = s.Attack = s.AttackHold = s.Heavy = s.Dodge = false; }

        static IEnumerator WaitFor(System.Func<bool> cond, float timeout, string what)
        {
            float t0 = Time.realtimeSinceStartup; int frames = 0;
            while ((Time.realtimeSinceStartup - t0 < timeout || frames < 10) && !cond()) { frames++; yield return null; }
            Assert.IsTrue(cond(), what + $" (not within {timeout}s)");
        }

        HitRecorder Dummy()
        {
            var g = GameObject.CreatePrimitive(PrimitiveType.Cube); g.name = "PunchDummy";
            var p = _player.transform;
            g.transform.position = p.position + p.forward * 0.95f + Vector3.up * 1.0f;
            g.transform.rotation = p.rotation; g.transform.localScale = new Vector3(0.5f, 1.6f, 0.4f);
            _created.Add(g);
            return g.AddComponent<HitRecorder>();
        }

        ItemDefinition Item(string id, System.Action<ItemDefinition> setup = null)
        {
            var it = ScriptableObject.CreateInstance<ItemDefinition>();
            it.name = "ITEM_" + id; it.id = id; it.displayName = id; it.maxStack = 10; it.category = ItemCategory.Resource;
            setup?.Invoke(it); _created.Add(it);
            return it;
        }

        void SetStamina(float v) { if (_sv) _sv.SetStats(_sv.Hunger, _sv.Thirst, v, _sv.BodyTemperature, _sv.Wetness); }

        IEnumerator Tap() { PlayerInputReader.Sim.Attack = true; yield return null; yield return null; }

        // ------------------------------------------------------------------ tests
        [UnityTest, Timeout(120000)] public IEnumerator Starts_Unarmed_With_The_Fists()
        {
            yield return null; yield return null;
            Assert.IsNull(_inv.ActiveItem, "nothing in hand");
            Assert.IsTrue(_wc.BareHanded, "the fists are the weapon");
            var d = _wc.CurrentData;
            Assert.IsNotNull(d); Assert.IsTrue(d.unarmed); Assert.IsFalse(d.IsRanged); Assert.IsTrue(d.HasHeavy);
            Assert.AreEqual(3, d.attacks.Length, "punch 1 -> 2 -> 3");
            Assert.AreEqual(PlayerActions.BareHandPunch1, d.attacks[0].action); Assert.AreEqual(PlayerActions.BareHandPunch2, d.attacks[1].action);
            Assert.AreEqual(PlayerActions.BareHandPunch3, d.attacks[2].action); Assert.AreEqual(PlayerActions.BareHandHeavy, d.heavyAttack.action);
            Assert.Less(d.damage, 8f, "hands are weak (emergency option)");
            Assert.IsFalse(PlayerCombat.CanBlockWith(d), "no block with bare hands");
            Assert.AreEqual(PlayerActivity.Idle, PlayerState.Instance.Activity);
            Assert.AreEqual("PUNCH", MobileHUD.AttackLabel(false, null, d, false));
            var lines = new List<string>(); ContextHints.Compose(new HintContext { held = HeldKind.Empty }, lines);
            Assert.IsTrue(lines.Any(l => l.Contains("Punch")) && lines.Any(l => l.Contains("Heavy punch")), string.Join(" | ", lines));
            Debug.Log($"[BareHand] data {d.name}: damage {d.damage} / {d.heavyDamage}, stamina {d.staminaCost}, reach {d.reach}, knockback {d.knockback} / {d.heavyKnockback}");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Light_Combo_1_2_3_Hits_With_Events_And_Spends_Stamina()
        {
            var dummy = Dummy();
            yield return null;
            SetStamina(100f);
            var d = _wc.CurrentData;
            var seen = new List<int>(); float st0 = _sv ? _sv.Stamina : 0f;
            yield return Tap();
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandPunch1, 0.5f, "punch 1 starts");
            seen.Add(_wc.CurrentAttackAction);
            float st1 = _sv ? _sv.Stamina : 0f;
            yield return WaitFor(() => _anim.GetCurrentAnimatorStateInfo(0).IsName("BareHand_Punch_1") || _anim.GetNextAnimatorStateInfo(0).IsName("BareHand_Punch_1"), 0.5f, "BareHand_Punch_1 state");
            Assert.AreEqual(PlayerActivity.Attack, PlayerState.Instance.Activity, "PlayerState reports the attack");
            yield return new WaitForSeconds(0.15f);
            yield return Tap();                                               // pressed mid-swing: queued, chains
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandPunch2, 2.5f, "punch 2 follows");
            seen.Add(_wc.CurrentAttackAction);
            yield return new WaitForSeconds(0.15f);
            yield return Tap();
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandPunch3, 2.5f, "punch 3 follows");
            seen.Add(_wc.CurrentAttackAction);
            yield return WaitFor(() => !_wc.IsAttacking && !_drv.IsBusy, 3f, "back to movement after the combo");
            CollectionAssert.AreEqual(new[] { PlayerActions.BareHandPunch1, PlayerActions.BareHandPunch2, PlayerActions.BareHandPunch3 }, seen);
            Assert.IsTrue(_motor.CanMove, "movement comes back");
            // one hit per punch, weak, unarmed, with knockback; the finisher hits harder and staggers
            Assert.AreEqual(3, dummy.Hits.Count, "one hit per punch: " + string.Join(", ", dummy.Hits.Select(h => h.damage.ToString("F1"))));
            Assert.IsTrue(dummy.Hits.All(h => h.unarmed), "HitInfo.unarmed on every punch");
            Assert.IsTrue(dummy.Hits.All(h => h.knockback > 0f), "knockback set");
            Assert.AreEqual(d.damage * d.attacks[0].damageMultiplier, dummy.Hits[0].damage, 0.01f);
            Assert.AreEqual(d.damage * d.attacks[2].damageMultiplier, dummy.Hits[2].damage, 0.01f);
            Assert.Greater(dummy.Hits[2].damage, dummy.Hits[0].damage, "the third punch is the strongest");
            Assert.IsFalse(dummy.Hits[0].heavy); Assert.IsTrue(dummy.Hits[2].heavy, "the finisher staggers");
            // hit timing came from the clips' events (one OnAttackHit per punch, raised while that punch ran)
            foreach (var a in seen) Assert.IsTrue(_eventLog.Any(e => e.action == a && e.evt == "OnAttackHit"), $"OnAttackHit during action {a}: " + string.Join(", ", _eventLog.Select(e => e.action + ":" + e.evt)));
            if (_sv) Assert.AreEqual(st0 - d.staminaCost * d.attacks[0].staminaMultiplier, st1, 0.6f, "punch 1 stamina");
            Debug.Log($"[BareHand] combo {string.Join(" -> ", seen)} hits {string.Join(" / ", dummy.Hits.Select(h => $"{h.damage:F1} kb {h.knockback:F2}{(h.heavy ? " heavy" : "")}"))} " +
                      $"events {string.Join(", ", _eventLog.Select(e => e.action + ":" + e.evt))} stamina {st0:F1} -> {st1:F1} after punch 1");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Heavy_On_Hold_And_On_The_Heavy_Button()
        {
            var dummy = Dummy();
            yield return null;
            SetStamina(100f);
            var d = _wc.CurrentData; float st0 = _sv ? _sv.Stamina : 0f;
            PlayerInputReader.Sim.Attack = true; PlayerInputReader.Sim.AttackHold = true;
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandHeavy, 1.0f, "hold -> heavy punch");
            float st1 = _sv ? _sv.Stamina : 0f;
            Assert.IsTrue(_wc.CurrentIsHeavy);
            yield return null;                                                // PlayerState samples in its Update (next frame)
            Assert.AreEqual(PlayerActivity.HeavyAttack, PlayerState.Instance.Activity);
            PlayerInputReader.Sim.AttackHold = false;
            yield return WaitFor(() => !_wc.IsAttacking && !_drv.IsBusy, 3f, "heavy ends");
            Assert.AreEqual(1, dummy.Hits.Count, "one heavy hit");
            var h = dummy.Hits[0];
            Assert.IsTrue(h.heavy && h.unarmed); Assert.AreEqual(d.heavyDamage, h.damage, 0.01f); Assert.AreEqual(d.heavyKnockback, h.knockback, 0.01f);
            if (_sv) Assert.AreEqual(st0 - d.staminaCost * d.heavyStaminaMultiplier, st1, 0.6f, "heavy stamina");
            // the separate HEAVY button (touch / gamepad): heavy at once, no hold
            yield return new WaitForSeconds(0.3f);
            PlayerInputReader.Sim.Heavy = true;
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandHeavy, 0.5f, "HEAVY button -> heavy punch");
            yield return WaitFor(() => !_wc.IsAttacking && !_drv.IsBusy, 3f, "second heavy ends");
            Assert.AreEqual(2, dummy.Hits.Count);
            Debug.Log($"[BareHand] heavy dmg {h.damage} kb {h.knockback} stamina {st0:F1} -> {st1:F1}");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Too_Tired_To_Punch()
        {
            var dummy = Dummy();
            yield return null;
            if (!_sv) Assert.Ignore("no PlayerSurvival on the prefab");
            SetStamina(1f);
            yield return Tap();
            yield return new WaitForSeconds(0.3f);
            Assert.IsFalse(_wc.IsAttacking, "no punch without stamina");
            Assert.AreEqual(0, dummy.Hits.Count);
        }

        [UnityTest, Timeout(120000)] public IEnumerator Items_With_A_Use_Keep_It_Items_Without_A_Role_Punch()
        {
            var dummy = Dummy();
            var wood = Item("t_wood");
            var berry = Item("t_berry", i => { i.category = ItemCategory.Food; i.hunger = 5f; });
            _inv.SetSlot(0, new ItemStack(wood, 3)); _inv.SetSlot(1, new ItemStack(berry, 2)); _inv.SetActiveSlot(0);
            yield return null; yield return null;
            Assert.IsTrue(WeaponController.FightsBareHanded(wood) && _wc.BareHanded, "wood in hand: fists");
            SetStamina(100f);
            yield return Tap();
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandPunch1, 0.5f, "punch with wood in hand");
            yield return WaitFor(() => !_wc.IsAttacking && !_drv.IsBusy, 3f, "punch ends");
            Assert.AreEqual(1, dummy.Hits.Count, "the punch lands");
            Assert.AreEqual(3, _inv.Count(wood), "the held resource is not used up or worn");
            _inv.SetActiveSlot(1);
            yield return null; yield return null;
            Assert.IsFalse(WeaponController.FightsBareHanded(berry));
            yield return Tap();
            yield return WaitFor(() => _drv.CurrentAction == PlayerActions.Eat, 1.0f, "food in hand: attack eats");
            Assert.IsFalse(_wc.IsAttacking, "no punch while eating");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Spear_Still_Fights_And_Hotbar_Returns_To_The_Fists()
        {
            var dummy = Dummy();
            var wd = ScriptableObject.CreateInstance<WeaponData>();
            wd.name = "WPN_t_spear"; wd.kind = WeaponKind.Spear; wd.throwable = true; wd.damage = 14f; wd.heavyDamage = 22f; wd.reach = 2.1f;
            wd.attacks = new[] { new AttackProfile(PlayerActions.AttackSpear) }; wd.heavyAttack = new AttackProfile(PlayerActions.AttackSpearHeavy);
            _created.Add(wd);
            var spear = Item("t_spear", i => { i.category = ItemCategory.Weapon; i.weapon = WeaponKind.Spear; i.maxStack = 1; i.weaponData = wd; });
            _inv.SetSlot(0, new ItemStack(spear, 1)); _inv.SetActiveSlot(0);
            yield return null; yield return null;
            Assert.AreSame(wd, _wc.CurrentData, "the spear's data");
            Assert.IsFalse(_wc.BareHanded);
            SetStamina(100f);
            yield return Tap();
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.AttackSpear, 0.5f, "spear thrust");
            yield return WaitFor(() => !_wc.IsAttacking && !_drv.IsBusy, 3f, "thrust ends");
            Assert.AreEqual(1, dummy.Hits.Count, "the spear hits");
            Assert.IsFalse(dummy.Hits[0].unarmed, "a spear hit is not unarmed");
            Assert.AreEqual(14f, dummy.Hits[0].damage, 0.01f);
            // hotbar to an empty slot: the fists again
            _inv.SetActiveSlot(1);
            yield return null; yield return null;
            Assert.IsTrue(_wc.BareHanded, "empty slot: bare hands");
            yield return Tap();
            yield return WaitFor(() => _wc.CurrentAttackAction == PlayerActions.BareHandPunch1, 0.5f, "punch after switching");
            yield return WaitFor(() => !_wc.IsAttacking && !_drv.IsBusy, 3f, "punch ends");
            Assert.AreEqual(2, dummy.Hits.Count); Assert.IsTrue(dummy.Hits[1].unarmed);
            // and back to the spear
            _inv.SetActiveSlot(0);
            yield return null; yield return null;
            Assert.AreSame(wd, _wc.CurrentData, "back to the spear");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Dodge_Has_IFrames_Stamina_And_Cooldown()
        {
            yield return null;
            SetStamina(100f);
            var hp = _player.GetComponent<PlayerHealth>();
            float st0 = _sv ? _sv.Stamina : 0f, h0 = hp.Health;
            PlayerInputReader.Sim.Dodge = true;
            yield return WaitFor(() => _drv.CurrentAction == PlayerActions.Dodge || _anim.GetCurrentAnimatorStateInfo(0).IsName("Dodge") || _anim.GetNextAnimatorStateInfo(0).IsName("Dodge"), 0.5f, "dodge plays");
            Assert.IsTrue(hp.Invulnerable, "invulnerable during the dodge");
            hp.TakeDamage(10f, _player.transform.position + _player.transform.forward * 2f, false);
            Assert.AreEqual(h0, hp.Health, 0.01f, "a hit during the dodge misses");
            if (_sv) Assert.Less(_sv.Stamina, st0 - _combat.dodgeStamina * 0.9f, "the dodge costs stamina");
            Assert.IsFalse(_combat.TryDodge(), "cooldown: no second dodge at once");
            yield return new WaitForSeconds(_combat.dodgeInvulnerable.y + 0.1f);
            Assert.IsFalse(hp.Invulnerable, "the window closes");
        }

        [Test] public void Touch_Labels_Follow_The_Prompt()
        {
            Assert.AreEqual("GATHER", MobileHUD.ContextLabel("Gather Driftwood", false, false));
            Assert.AreEqual("GATHER", MobileHUD.ContextLabel("Chop tree", false, false));
            Assert.AreEqual("GATHER", MobileHUD.ContextLabel("Butcher Raptor", false, false));
            Assert.AreEqual("DRINK", MobileHUD.ContextLabel("Drink", false, false));
            Assert.AreEqual("FILL", MobileHUD.ContextLabel("Fill Gourd", false, false));
            Assert.AreEqual("HARVEST", MobileHUD.ContextLabel("Harvest berries", false, false));
            Assert.AreEqual("HARVEST", MobileHUD.ContextLabel("Pick the fruit", false, true));
            Assert.AreEqual("CLIMB", MobileHUD.ContextLabel("Climb the Palm", true, false));
            Assert.AreEqual("CLIMB", MobileHUD.ContextLabel("W / S climb", false, true));
            Assert.AreEqual("PICK UP", MobileHUD.ContextLabel("Pick up Stone x2", false, false));
            Assert.AreEqual("USE", MobileHUD.ContextLabel("Sleep", false, false));
            Assert.AreEqual("GATHER", MobileHUD.ContextLabel("Catch Fish", false, false), "fish shoal");
            Assert.AreEqual("HARVEST", MobileHUD.ContextLabel("Harvest", false, false), "food node prompt");
        }

        // ------------------------------------------------------------------ integration round
        [UnityTest, Timeout(120000)] public IEnumerator Arm_Injury_Weakens_The_Punch()
        {
            var dummy = Dummy();
            var fx = _player.GetComponent<PlayerHealth>().Effects;
            Assert.IsNotNull(fx, "PlayerStatusEffects");
            fx.Apply(StatusEffectIds.ArmInjury, 1f, 60f, false);
            yield return null;
            float k = fx.AttackMultiplier;
            Assert.Less(k, 1f, "arm injury lowers the attack multiplier");
            SetStamina(100f);
            yield return Tap();
            yield return WaitFor(() => dummy.Hits.Count > 0, 2.5f, "the punch lands");
            var d = _wc.CurrentData ?? _wc.BareHandData;
            Assert.AreEqual(d.damage * d.attacks[0].damageMultiplier * k, dummy.Hits[0].damage, 0.01f, "punch damage x AttackMultiplier");
            Debug.Log($"[BareHand] arm injury: AttackMultiplier {k:F2}, jab {dummy.Hits[0].damage:F2} (healthy {d.damage:F2})");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Every_Clip_Event_Has_A_Receiver()
        {
            yield return null;
            var ac = _anim.runtimeAnimatorController; Assert.IsNotNull(ac);
            var missing = new SortedSet<string>(); int n = 0;
            foreach (var clip in ac.animationClips)
                foreach (var e in clip.events)
                {
                    n++;
                    if (typeof(CharacterAnimationEvents).GetMethod(e.functionName, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance) == null)
                        missing.Add(e.functionName + " (" + clip.name + ")");
                }
            foreach (var fn in new[] { "OnUseItem", "OnDrink", "OnGatherHit", "OnAttackStart", "OnAttackActive", "OnAttackHit", "OnAttackEnd", "OnDodge", "OnClimbStep", "OnClimbGrab" })
                if (typeof(CharacterAnimationEvents).GetMethod(fn) == null) missing.Add(fn + " (needed by the new clips)");
            Assert.IsEmpty(missing, "events without a receiver: " + string.Join(", ", missing));
            Debug.Log($"[BareHand] {n} clip events checked, all have receivers");
        }

        [UnityTest, Timeout(120000)] public IEnumerator Missed_Projectiles_Raise_ProjectileLanded()
        {
            var got = new List<GameEvent>();
            System.Action<GameEvent> h = e => { if (e.type == GameEventType.ProjectileLanded) got.Add(e); };
            GameEvents.Raised += h;
            try
            {
                var spear = Item("t_spear", i => { i.category = ItemCategory.Weapon; i.weapon = WeaponKind.Spear; i.maxStack = 1; });
                Projectile.Launch(null, new Vector3(3f, 2f, 3f), new Vector3(0f, -6f, 4f), new HitInfo { damage = 5f, attacker = _player }, _player, 0f, true);
                Projectile.Launch(new ItemStack(spear, 1), new Vector3(-3f, 2f, 3f), new Vector3(0f, -6f, 4f), new HitInfo { damage = 20f, attacker = _player }, _player, 0f, false);
                yield return WaitFor(() => got.Count >= 2, 3f, "both came to rest");
                var arrow = got.First(e => e.id == "arrow"); var sp = got.First(e => e.id == "t_spear");
                Assert.AreEqual(1, arrow.amount, "arrow loudness"); Assert.AreEqual(2, sp.amount, "spear loudness");
                Assert.AreEqual(0f, arrow.position.y, 0.3f, "arrow position on the ground"); Assert.AreEqual(0f, sp.position.y, 0.3f, "spear position on the ground");
                Assert.Greater(arrow.position.z, 3f, "landed ahead of the launch point");
                Debug.Log($"[BareHand] ProjectileLanded arrow {arrow.id} x{arrow.amount} at {arrow.position}, spear {sp.id} x{sp.amount} at {sp.position}");
            }
            finally { GameEvents.Raised -= h; }
        }
    }

    /// <summary>bare hands on the island: a small creature takes the punch, a large one barely notices</summary>
    public class BareHandIslandTests
    {
        GameManager _gm;
        IEnumerator LoadIsland()
        {
            TestScenes.UseTestSaves(); GameManager.ForceShowTitle = false; GameManager.ForcePlayIntro = false; PlayerInputReader.Simulate = true;
#if UNITY_EDITOR
            yield return UnityEditor.SceneManagement.EditorSceneManager.LoadSceneAsyncInPlayMode("Assets/_Project/Scenes/Island_VerticalSlice.unity", new LoadSceneParameters(LoadSceneMode.Single));
#endif
            float t = 0; while ((_gm = GameManager.Instance) == null || _gm.State != GameState.Playing) { t += Time.unscaledDeltaTime; if (t > 20f) break; yield return null; }
            yield return new WaitForSeconds(1f);
        }
        [TearDown] public void Cleanup() { GameManager.ForceShowTitle = null; GameManager.ForcePlayIntro = null; PlayerInputReader.Simulate = false; PlayerInputReader.Sim.Attack = false; Time.timeScale = 1f; }
        [UnityTearDown] public IEnumerator Unload() { yield return TestScenes.Clear(); }

        /// <summary>stand the player so its chest is ~0.45 m from the creature's nearest collider, facing it</summary>
        static IEnumerator StandBy(PlayerMotor motor, DinosaurController d)
        {
            var cols = d.GetComponentsInChildren<Collider>().Where(c => c.enabled && !(c is CharacterController)).ToArray();
            Assert.Greater(cols.Length, 0, d.name + " has colliders");
            var b = cols[0].bounds; foreach (var c in cols) b.Encapsulate(c.bounds);
            var side = d.transform.right; var ter = Terrain.activeTerrain;
            Vector3 pos = b.center + side * (Vector3.Dot(b.extents, new Vector3(Mathf.Abs(side.x), Mathf.Abs(side.y), Mathf.Abs(side.z))) + 0.6f);
            for (int i = 0; i < 4; i++)
            {
                if (ter) pos.y = ter.SampleHeight(pos) + ter.transform.position.y + 0.05f;
                var face = b.center - pos; face.y = 0f;
                motor.Warp(pos, Quaternion.LookRotation(face.sqrMagnitude > 1e-4f ? face.normalized : Vector3.forward));
                yield return null; yield return null;
                Vector3 chest = motor.transform.position + Vector3.up * 1.0f;
                float best = float.MaxValue; Vector3 bp = b.center;
                foreach (var c in cols) { var p = c.ClosestPoint(chest); float dist = (p - chest).magnitude; if (dist < best) { best = dist; bp = p; } }
                Vector3 to = bp - chest; to.y = 0f;
                if (best < 0.7f) break;
                pos += to.normalized * (to.magnitude - 0.45f);
            }
        }

        static float Ground(Vector3 p) { var t = Terrain.activeTerrain; return t ? t.SampleHeight(p) + t.transform.position.y : p.y; }
        static bool NothingElseNear(Vector3 p, float r, Object except)
        {
            foreach (var it in PrimalFrontier.World.Interactable.Active)
                if (it && it != except && !it.LargeArea && (it.transform.position - p).sqrMagnitude < r * r) return false;
            return true;
        }
        static string Label(MobileHUD hud, string button)
        {
            var t = hud.transform.Find("[Touch]/SafeArea/" + button);
            var tx = t ? t.GetComponentInChildren<UnityEngine.UI.Text>(true) : null;
            return t && t.gameObject.activeInHierarchy && tx ? tx.text : null;
        }

        /// <summary>the touch HUD on the island: PUNCH / HEAVY with bare hands, GATHER / DRINK / FILL / CLIMB from the real prompts</summary>
        [UnityTest, Timeout(180000)] public IEnumerator Touch_Buttons_Show_The_Context()
        {
            int prev = GameSettings.TouchControls;
            GameSettings.TouchControls = 1;
            try
            {
                yield return LoadIsland();
                var player = _gm.Player; var pi = player.GetComponent<PlayerInteraction>(); var motor = player.GetComponent<PlayerMotor>();
                var inv = player.GetComponent<InventorySystem>(); inv.Clear();
                player.GetComponent<PlayerHealth>().InvulnerableUntil = Time.time + 120f;
                var hud = Object.FindFirstObjectByType<MobileHUD>(); Assert.IsNotNull(hud, "MobileHUD in the scene");
                float t0 = Time.realtimeSinceStartup; while (!hud.Visible && Time.realtimeSinceStartup - t0 < 5f) yield return null;
                Assert.IsTrue(hud.Visible, "touch controls shown (TouchControls = on)");
                yield return null; yield return null;
                var report = new System.Text.StringBuilder();
                Assert.AreEqual("PUNCH", Label(hud, "Attack"), "bare hands: the attack button punches");
                Assert.IsNotNull(Label(hud, "Heavy"), "bare hands: HEAVY shown");
                report.Append($"bare hands: {Label(hud, "Attack")} + {Label(hud, "Heavy")}; ");

                IEnumerator Face(PrimalFrontier.World.Interactable target, Vector3 stand, Vector3 look, string want)
                {
                    var face = look - stand; face.y = 0f;
                    motor.Warp(stand + Vector3.up * 0.3f, Quaternion.LookRotation(face.sqrMagnitude > 1e-4f ? face.normalized : Vector3.forward));
                    float w = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - w < 2f && pi.Target != target) yield return null;
                    w = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - w < 1.5f && !(pi.PromptEnabled && motor.IsGrounded)) yield return null;   // landed from the warp
                    yield return null; yield return null;
                    string got = Label(hud, "Use");
                    report.Append($"{target.name} '{pi.Prompt}' -> {got}; ");
                    Assert.AreSame(target, pi.Target, $"{want}: the scan targets {target.name} (target {(pi.Target ? pi.Target.name : "none")})");
                    Assert.AreEqual(want, got, $"prompt '{pi.Prompt}' (enabled {pi.PromptEnabled}, grounded {motor.IsGrounded}, PlayerClimb {(player.GetComponent<PlayerClimb>() != null)})");
                }

                // a resource node: GATHER
                var node = PrimalFrontier.World.Interactable.Active.OfType<PrimalFrontier.World.ResourceNode>()
                    .Where(n => n && !n.IsEmpty && n.CanInteract(pi) && NothingElseNear(n.transform.position, 3f, n))
                    .OrderBy(n => (n.transform.position - player.transform.position).sqrMagnitude).FirstOrDefault();
                Assert.IsNotNull(node, "a free-standing resource node");
                Vector3 np = node.transform.position; Vector3 away = (player.transform.position - np); away.y = 0f; away = away.sqrMagnitude > 0.01f ? away.normalized : Vector3.back;
                Vector3 stand = np + away * 1.1f; stand.y = Ground(stand);
                yield return Face(node, stand, np, "GATHER");

                // hold GATHER = hold E: gathering repeats while the button is held; a tap gathers once (ResourceManager.HoldToRepeat)
                var node2 = PrimalFrontier.World.Interactable.Active.OfType<PrimalFrontier.World.ResourceNode>()
                    .Where(n => n && n.Remaining >= 4 && n.CanInteract(pi) && n.Def.category != PrimalFrontier.World.ResourceCategory.Food && NothingElseNear(n.transform.position, 3f, n))
                    .OrderBy(n => (n.transform.position - player.transform.position).sqrMagnitude).FirstOrDefault();
                if (node2 && PrimalFrontier.World.ResourceManager.HoldToRepeat)
                {
                    Vector3 p2 = node2.transform.position; Vector3 a2 = player.transform.position - p2; a2.y = 0f; a2 = a2.sqrMagnitude > 0.01f ? a2.normalized : Vector3.back;
                    Vector3 s2 = p2 + a2 * 1.1f; s2.y = Ground(s2);
                    yield return Face(node2, s2, p2, "GATHER");
                    var use = hud.transform.Find("[Touch]/SafeArea/Use").GetComponent<TouchButton>();
                    PlayerInputReader.Simulate = false;                      // the touch button path (PlayerInputReader.Virtual), as on a phone
                    try
                    {
                        int r0 = node2.Remaining;
                        use.Down();
                        float g0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - g0 < 10f && r0 - node2.Remaining < 2) yield return null;
                        int held = r0 - node2.Remaining;
                        use.Up();
                        g0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - g0 < 5f && pi.InAction) yield return null;
                        int afterRelease = r0 - node2.Remaining;
                        Assert.GreaterOrEqual(held, 2, "holding GATHER repeats the gather");
                        Assert.IsFalse(pi.InAction, "releasing stops after the current hit");
                        yield return new WaitForSeconds(0.3f);
                        int r1 = node2.Remaining;
                        use.Down(); yield return null; yield return null; use.Up();
                        g0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - g0 < 1f && !pi.InAction) yield return null;
                        g0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - g0 < 5f && pi.InAction) yield return null;
                        int tap = r1 - node2.Remaining;
                        report.Append($"hold GATHER on {node2.name}: {held} hits while held, {afterRelease} after release; tap: {tap}; ");
                        Assert.AreEqual(1, tap, "a tap gathers once");
                    }
                    finally { PlayerInputReader.Simulate = true; }
                }
                else report.Append("hold-to-repeat not checked (no node with 4 left, or HoldToRepeat off); ");

                // a food node: HARVEST (checked on its own, not whatever node is nearest)
                var food = Object.FindObjectsByType<PrimalFrontier.World.ResourceNode>(FindObjectsSortMode.None)
                    .Where(n => n && n.isActiveAndEnabled && !n.IsEmpty && n.Def.category == PrimalFrontier.World.ResourceCategory.Food && n.CanInteract(pi))
                    .OrderBy(n => (n.transform.position - player.transform.position).sqrMagnitude).FirstOrDefault(n => NothingElseNear(n.transform.position, 2.5f, n));
                Assert.IsNotNull(food, "a free-standing food node (berries / fruit / edible plant)");
                {
                    Vector3 fp = food.transform.position; Vector3 fa = player.transform.position - fp; fa.y = 0f; fa = fa.sqrMagnitude > 0.01f ? fa.normalized : Vector3.back;
                    Vector3 fs = fp + fa * 1.1f; fs.y = Ground(fs);
                    yield return Face(food, fs, fp, "HARVEST");
                }

                // a climbable tree: CLIMB
                var tree = Object.FindObjectsByType<PrimalFrontier.World.Climbable>(FindObjectsSortMode.None).FirstOrDefault(c => c && c.isActiveAndEnabled);
                if (tree)
                {
                    Vector3 tp = tree.FocusPoint; Vector3 dir = tree.transform.forward; dir.y = 0f; dir = dir.sqrMagnitude > 0.01f ? dir.normalized : Vector3.forward;
                    Vector3 ts = tp + dir * 1.0f; ts.y = Ground(ts);
                    yield return Face(tree, ts, tp, "CLIMB");
                    // and the button really climbs (a fresh player used to get a greyed prompt: no PlayerClimb yet)
                    var climb = player.GetComponent<PlayerClimb>();
                    Assert.IsNotNull(climb, "PlayerClimb present from the start");
                    PlayerInputReader.Sim.Interact = true;
                    float c0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - c0 < 2f && !climb.IsClimbing) yield return null;
                    Assert.IsTrue(climb.IsClimbing, "E / CLIMB starts climbing");
                    yield return new WaitForSeconds(1.2f);
                    report.Append($"climbing -> {Label(hud, "Use")}; ");
                    PlayerInputReader.Sim.Jump = true;
                    c0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - c0 < 4f && climb.IsClimbing) { if (climb.State == PlayerClimb.Phase.Hanging) PlayerInputReader.Sim.Jump = true; yield return null; }
                    Assert.IsFalse(climb.IsClimbing, "let go");
                    yield return new WaitForSeconds(0.5f);
                }
                else report.Append("no climbable in reach of the scan; ");

                // fresh water: DRINK with empty hands, FILL with an empty container in hand
                var ws = PrimalFrontier.World.WaterSource.All.FirstOrDefault(w => w && w.surface && w.SourceType != WaterType.SaltWater);
                Assert.IsNotNull(ws, "a fresh water source");
                var b = ws.surface.GetComponent<Renderer>().bounds; bool found = false; Vector3 bank = default, water = default;
                for (float x = b.min.x - 2f; x <= b.max.x + 2f && !found; x += 1.5f)
                    for (float z = b.min.z - 2f; z <= b.max.z + 2f && !found; z += 1.5f)
                    {
                        var p = new Vector3(x, 0f, z); float d = ws.Closest(p, out var wpt);
                        if (d < 0.6f || d > 1.6f) continue;
                        float g = Ground(p); if (g < wpt.y - 0.4f || g > wpt.y + 1.0f) continue;
                        p.y = g; if (!NothingElseNear(p, 3.5f, ws)) continue;
                        bool other = false; foreach (var o in PrimalFrontier.World.WaterSource.All) if (o != ws && o.Closest(p, out _) < 4f) other = true;
                        if (other) continue;
                        bank = p; water = wpt; found = true;
                    }
                Assert.IsTrue(found, "a bank at " + ws.displayName);
                yield return Face(ws, bank, water, "DRINK");
                var cup = ItemDatabase.Instance.Item("leaf_cup");
                if (cup)
                {
                    inv.Add(cup, 1, true); inv.SetActiveSlot(0);
                    yield return new WaitForSeconds(0.3f);
                    string got = Label(hud, "Use"); report.Append($"{ws.name} with {cup.id} '{pi.Prompt}' -> {got}; ");
                    Assert.AreEqual("FILL", got, $"prompt '{pi.Prompt}'");
                    Assert.AreEqual("DRINK", Label(hud, "Attack"), "a water container in hand: the attack button drinks");
                    Assert.IsNull(Label(hud, "Heavy"), "no HEAVY with a container in hand");
                }
                Debug.Log("[BareHand] touch " + report);
            }
            finally { GameSettings.TouchControls = prev; }
        }

        /// <summary>a weapon breaking on a hit: exactly one ToolBreak sound and one ToolBroken event (the HUD's ToolBroke handler)</summary>
        [UnityTest, Timeout(180000)] public IEnumerator Weapon_Break_Plays_One_ToolBreak()
        {
            yield return LoadIsland();
            var player = _gm.Player; var inv = player.GetComponent<InventorySystem>(); inv.Clear();
            var wc = player.GetComponent<PlayerCombat>().Weapons; var sv = player.GetComponent<PlayerSurvival>();
            player.GetComponent<PlayerHealth>().InvulnerableUntil = Time.time + 60f;
            var wd = ScriptableObject.CreateInstance<WeaponData>();
            wd.name = "WPN_t_brittle"; wd.kind = WeaponKind.Knife; wd.damage = 6f; wd.reach = 1.35f; wd.durabilityCost = 1f;
            wd.attacks = new[] { new AttackProfile(PlayerActions.KnifeAttack) }; wd.heavyAttack = new AttackProfile();
            var it = ScriptableObject.CreateInstance<ItemDefinition>();
            it.name = "ITEM_t_brittle"; it.id = "t_brittle"; it.displayName = "Brittle knife"; it.maxStack = 1; it.category = ItemCategory.Weapon;
            it.weapon = WeaponKind.Knife; it.weaponData = wd; it.maxDurability = 1f;
            var dummy = GameObject.CreatePrimitive(PrimitiveType.Cube); dummy.name = "BreakDummy";
            try
            {
                var pt = player.transform;
                dummy.transform.position = pt.position + pt.forward * 0.95f + Vector3.up * 1.0f; dummy.transform.rotation = pt.rotation;
                dummy.transform.localScale = new Vector3(0.5f, 1.6f, 0.4f);
                var rec = dummy.AddComponent<HitRecorder>();
                inv.SetSlot(0, new ItemStack(it, 1) { durability = 1f }); inv.SetActiveSlot(0);
                yield return null; yield return null;
                int sounds = 0, events = 0;
                System.Action<SfxId, Vector3> onSfx = (id, p) => { if (id == SfxId.ToolBreak) sounds++; };
                System.Action<GameEvent> onEv = e => { if (e.type == GameEventType.ToolBroken) events++; };
                SfxPlayer.Played += onSfx; GameEvents.Raised += onEv;
                try
                {
                    if (sv) sv.SetStats(sv.Hunger, sv.Thirst, sv.maxStamina, sv.BodyTemperature, sv.Wetness);
                    PlayerInputReader.Sim.Attack = true;
                    float t0 = Time.realtimeSinceStartup; while (Time.realtimeSinceStartup - t0 < 3f && inv.Get(0) != null) yield return null;
                    Assert.AreEqual(1, rec.Hits.Count, "the knife hit");
                    Assert.IsNull(inv.Get(0), "the knife broke");
                    yield return new WaitForSeconds(0.6f);
                    Assert.AreEqual(1, events, "one ToolBroken event");
                    Assert.AreEqual(1, sounds, "exactly one ToolBreak sound per break");
                    Debug.Log($"[BareHand] weapon break: {sounds} ToolBreak sound(s), {events} ToolBroken event(s)");
                }
                finally { SfxPlayer.Played -= onSfx; GameEvents.Raised -= onEv; }
            }
            finally { Object.Destroy(dummy); Object.Destroy(it); Object.Destroy(wd); }
        }

        [UnityTest, Timeout(180000)] public IEnumerator Punch_Small_Creature_Hurts_Large_Barely()
        {
            yield return LoadIsland();
            var player = _gm.Player; Assert.IsNotNull(player, "player");
            var inv = player.GetComponent<InventorySystem>(); inv.Clear();
            var motor = player.GetComponent<PlayerMotor>(); var hp = player.GetComponent<PlayerHealth>(); var sv = player.GetComponent<PlayerSurvival>();
            var wc = player.GetComponent<PlayerCombat>().Weapons;
            var landed = new List<(IDamageable t, HitInfo h)>();
            wc.TargetHit += (t, h) => landed.Add((t, h));
            var dinos = DinosaurController.All.Where(x => x && x.IsAlive && x.def).ToList();
            Assert.GreaterOrEqual(dinos.Count, 2, "dinosaurs on the island");
            // small: the lightest land creature; large: a big low-bodied one a standing punch can reach (the apex's body is above the fists)
            var land = dinos.Where(x => x.def.id != "pteranodon" && x.def.id != "mosasaurus").ToList();
            var small = land.OrderBy(x => x.def.maxHealth).First();
            var large = land.FirstOrDefault(x => x.def.id == "ankylosaurus") ?? land.FirstOrDefault(x => x.def.id == "triceratops") ?? land.OrderByDescending(x => x.def.maxHealth).First();
            var report = new System.Text.StringBuilder();
            foreach (var d in new[] { small, large })
            {
                d.enabled = false;                                             // hold still: only the hit is under test
                yield return StandBy(motor, d);
                hp.InvulnerableUntil = Time.time + 30f;                        // other creatures must not interrupt the punch
                if (sv) sv.SetStats(sv.Hunger, sv.Thirst, sv.maxStamina, sv.BodyTemperature, sv.Wetness);
                yield return new WaitForSeconds(0.2f);
                float h0 = d.Health; int n0 = landed.Count; bool swung = false;
                PlayerInputReader.Sim.Attack = true;
                float t0 = Time.realtimeSinceStartup;
                while (Time.realtimeSinceStartup - t0 < 3f && !landed.Skip(n0).Any(x => ReferenceEquals(x.t, d))) { swung |= wc.IsAttacking; yield return null; }
                var hit = landed.Skip(n0).FirstOrDefault(x => ReferenceEquals(x.t, d));
                Vector3 chest = motor.transform.position + Vector3.up * 1.0f;
                float gap = d.GetComponentsInChildren<Collider>().Where(c => c.enabled && !(c is CharacterController)).Select(c => (c.ClosestPoint(chest) - chest).magnitude).DefaultIfEmpty(-1f).Min();
                Assert.IsNotNull(hit.t, $"the punch reaches the {d.def.id} (swung {swung}, chest-to-body {gap:F2} m, grounded {motor.IsGrounded}, hits: {string.Join(", ", landed.Skip(n0).Select(x => (x.t as Component) ? ((Component)x.t).name : "?"))})");
                Assert.IsTrue(hit.h.unarmed, "sent as unarmed");
                float lost = h0 - d.Health;
                report.Append($"{d.def.id} (max {d.def.maxHealth}): sent {hit.h.damage:F1}, lost {lost:F2} ({lost / d.def.maxHealth * 100f:F2} %); ");
                if (d == small) Assert.Greater(lost, 0f, "a small creature takes the punch");
                else Assert.Less(lost / d.def.maxHealth, 0.02f, "a large creature barely notices");
                yield return new WaitForSeconds(1.2f);
                d.enabled = true;
            }
            bool scaled = landed.Count > 0 && large.def && large.Health > large.def.maxHealth - landed.Last().h.damage + 0.01f;
            Debug.Log("[BareHand] " + report + (scaled ? "AI scales unarmed hits" : "AI unarmed scaling not active yet (plain damage)"));
        }
    }
}
