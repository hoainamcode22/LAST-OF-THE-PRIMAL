        struct Def
        {
            public string id, name, prompt, item, hint; public ResourceCategory cat; public ResourceSize size;
            public int min, max; public ToolKind best, req; public float hands, gather, respawn, damagePerUnit, damaged, depleted, sink, radius;
            public int handAnim, toolAnim; public DepletedLook look; public bool punch;
        }

        static Def D(string id, string name, ResourceCategory cat, ResourceSize size, string prompt, string item, int min, int max, ToolKind best, ToolKind req, float hands,
                     float gather, int handAnim, int toolAnim, float respawn, DepletedLook look, float damaged = 0.75f, float depleted = 0.45f, float sink = 0.12f,
                     float radius = 0.4f, float damagePerUnit = 4f, string hint = null, bool punch = true) =>
            new Def { id = id, name = name, cat = cat, size = size, prompt = prompt, item = item, min = min, max = max, best = best, req = req, hands = hands, gather = gather,
                      handAnim = handAnim, toolAnim = toolAnim, respawn = respawn, look = look, damaged = damaged, depleted = depleted, sink = sink, radius = radius,
                      damagePerUnit = damagePerUnit, hint = hint, punch = punch };

        const string BigRockHint = "Too big to break by hand. A pick breaks it.";

